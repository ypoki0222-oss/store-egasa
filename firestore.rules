rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // المنتجات: أي زائر يمكنه القراءة، فقط المشرف (المسجل دخوله) يمكنه التعديل
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // الطلبات: أي زائر يمكنه إنشاء طلب، القراءة والتعديل والحذف للمشرف فقط
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // إعدادات المتجر: أي زائر يمكنه القراءة، فقط المشرف يمكنه التعديل
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // باقي المجموعات: مغلقة افتراضياً
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
